{
    "name": "jovibarba/contao-glightbox",
    "description": "Fork of inspiredminds/contao-glightbox: GLightbox options configurable in the page layout and per gallery element. Replaces the original package.",
    "type": "contao-bundle",
    "keywords": [
        "contao",
        "contao-bundle",
        "glightbox",
        "lightbox",
        "gallery"
    ],
    "license": "LGPL-3.0-or-later",
    "homepage": "https://github.com/Jovibarba/contao-glightbox",
    "authors": [
        {
            "name": "Fritz Michael Gschwantner",
            "email": "fmg@inspiredminds.at",
            "role": "Developer"
        },
        {
            "name": "Jovibarba",
            "homepage": "https://github.com/jovibarba",
            "role": "Fork maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Jovibarba/contao-glightbox/issues",
        "source": "https://github.com/Jovibarba/contao-glightbox"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/fritzmg"
        }
    ],
    "require": {
        "php": ">=8.1",
        "contao/core-bundle": "^5.3",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.4"
    },
    "replace": {
        "inspiredminds/contao-glightbox": "1.0.8"
    },
    "autoload": {
        "psr-4": {
            "InspiredMinds\\ContaoGLightbox\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "InspiredMinds\\ContaoGLightbox\\ContaoManager\\Plugin"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.16"
    }
}
