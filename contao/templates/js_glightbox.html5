<?php $GLOBALS['TL_CSS']['glightbox'] = 'bundles/contaoglightbox/css/glightbox.min.css|static'; ?>
<?php
// Optionen aus dem Seitenlayout (Abschnitt "GLightbox") laden.
// Nur gesetzte Werte werden übergeben, der Selektor ist fest vorgegeben.
$glightboxOptions = \InspiredMinds\ContaoGLightbox\GLightboxOptions::forCurrentPage();
$glightboxOptions['selector'] = 'a[data-lightbox]';
?>
<script src="<?= $this->asset('js/glightbox.min.js', 'contao_g_lightbox') ?>"></script>
<script<?= $this->attrs()->setIfExists('nonce', $this->nonce('script-src')) ?>>
(function(){
  'use strict';
  document.querySelectorAll('a[data-lightbox]').forEach((element) => {
    if (!!element.dataset.lightbox) {
      element.setAttribute('data-gallery', element.dataset.lightbox);
    } else {
      element.setAttribute('data-gallery', (Math.random() + 1).toString(36).substring(7));
    }
  });
  GLightbox(<?= json_encode($glightboxOptions, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) ?>);
})();
</script>
